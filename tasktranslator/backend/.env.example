ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — get from supabase.com project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend URL (used for Stripe redirect after payment)
FRONTEND_URL=http://localhost:5173

PORT=3003

# Which AI answers the tasks: claude (default) or gemini
AI_PROVIDER=claude
# Only needed when AI_PROVIDER=gemini (aistudio.google.com/apikey - use a PAID/billing-enabled key, see note in README)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Other settings the server reads
ADMIN_EMAILS=you@example.com
IP_HASH_SALT=any-long-random-string
# CORS_ORIGINS=https://another-site.com
