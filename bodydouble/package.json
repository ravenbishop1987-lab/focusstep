{
  "name": "focusmate-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-next-cache.mjs && next dev",
    "build:translator": "node scripts/build-translator.mjs && node scripts/sync-translator-assets.mjs",
    "build": "npm run build:translator && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "stripe:bootstrap": "node scripts/bootstrap-stripe.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.89.1",
    "@stripe/stripe-js": "^9.0.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.10.0",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
